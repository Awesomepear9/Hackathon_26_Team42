# Tile-Quelle (OpenMapTiles-Schema). Ohne Angabe: OpenFreeMap.
# VITE_TILES_TYPE=tilejson
# VITE_TILES_URL=https://api.maptiler.com/tiles/v3-openmaptiles/tiles.json?key=DEIN_KEY
# VITE_TILES_CREDIT=© MapTiler © OpenMapTiles
#
# VITE_TILES_TYPE=pmtiles
# VITE_TILES_URL=https://example.org/digifl-openmaptiles.pmtiles
#
# VITE_TILES_TYPE=xyz
# VITE_TILES_URL=https://tiles.example.org/{z}/{x}/{y}.pbf
# VITE_TILES_MAXZOOM=14
#
# DigiFL-Website mit dem Theorie-Dungeon (Ziel der Schwerter in der Navigation).
# Ohne Angabe: "/" – passt, wenn die App wie vorgesehen unter /apps/praxismodul/ der Website läuft.
# VITE_WEBSITE_URL=http://localhost:3000/
